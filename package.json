{
  "name": "synthonos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Natural language controlled virtual analog synthesizer. Runs locally in Tauri.",
  "scripts": {
    "dev": "vite",
    "build": "npm run codegen:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "render": "tsx scripts/render.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
